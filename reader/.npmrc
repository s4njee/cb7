# pnpm 11 runs a deps-status check before every `pnpm <script>` and, on a
# changed manifest, tries to reinstall — which fails non-interactively (no TTY)
# and blocks `tauri ios dev`'s `beforeDevCommand`. The install is already done;
# skip the pre-run check so scripts run directly.
verify-deps-before-run=false
confirm-modules-purge=false
